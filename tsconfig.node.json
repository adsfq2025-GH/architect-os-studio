{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node", "electron-vite/node"],
    "baseUrl": ".",
    "outDir": "dist-types-node"
  },
  "include": [
    "src/main/**/*.ts",
    "src/main/**/*.json",
    "src/preload/**/*.ts",
    "electron.vite.config.ts"
  ]
}
